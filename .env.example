# ─── Supabase Cloud Configuration ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ─── PostgreSQL Database Connection (Prisma) ──────────────────────────────────
# Transaction pooler URL (PGBouncer port 6543) for serverless environments
DATABASE_URL="postgresql://postgres.your-project-id:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (port 5432) for migrations & schema push
DIRECT_URL="postgresql://postgres.your-project-id:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Artificial Intelligence (Groq Cloud) ────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Upstash Redis (Rate Limiting & Caching) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ─── Courier & Logistics (TCS Pakistan) ──────────────────────────────────────
TCS_API_KEY=your-tcs-api-key
TCS_API_SECRET=your-tcs-api-secret
TCS_COST_CENTER_CODE=your-cost-center-code
TCS_ENVIRONMENT=sandbox # sandbox | production

# ─── Payment Gateways ────────────────────────────────────────────────────────
# Paddle (Global Cards)
PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
# JazzCash (Pakistani Mobile Wallet)
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
# EasyPaisa
EASYPAISA_STORE_ID=your-store-id
EASYPAISA_HASH_KEY=your-hash-key

# ─── Site & Deployment URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tailorlink.vercel.app
NEXT_PUBLIC_APP_ENV=production
